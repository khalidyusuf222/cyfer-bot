# Copy this file to ".env" and fill in your own values.
# NEVER commit .env or paste its contents into a chat.

# ===========================================================================
# Which broker
# ===========================================================================
# oanda  = forex (currencies). What this bot is built for. Positions divide
#          down to a single unit, so a small account can size correctly.
# alpaca = US shares. Kept working, but the strategy is a forex strategy
#          and share positions cannot be sized properly on £1,000.
BROKER=oanda

# ===========================================================================
# OANDA  --  practice by default
# ===========================================================================
# practice = simulated money on a demo account, real live prices.
# live     = REAL MONEY.
#
# Setting this to "live" is not enough on its own. You also need the live
# token and account below, a restart, AND to type the arming phrase in
# Discord. Four separate acts, deliberately.
OANDA_ENV=practice

# Demo account. Get these yourself at https://www.oanda.com:
#   1. Open a free demo account
#   2. Manage API Access -> Generate
#   3. Your account number is on the account page, like 101-004-12345678-001
# Generate and paste these yourself. Never send a token to anyone,
# including me.
OANDA_TOKEN=
OANDA_ACCOUNT=

# Only used when OANDA_ENV=live. DIFFERENT credentials from the demo ones,
# so a practice token can never reach a real account. Leave blank.
OANDA_LIVE_TOKEN=
OANDA_LIVE_ACCOUNT=

# ===========================================================================
# Where price data comes from
# ===========================================================================
# Leave this blank and it follows BROKER, which is what you want: the
# prices analysed are then the prices you actually trade at.
#   oanda  = OANDA's own candles (default when BROKER=oanda)
#   yahoo  = free, no account. Shares and indices only.
#   alpaca = US shares, needs the keys below.
# DATA_SOURCE=oanda

# ===========================================================================
# Alpaca  --  only if BROKER=alpaca or DATA_SOURCE=alpaca
# ===========================================================================
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_LIVE_KEY=
ALPACA_LIVE_SECRET=

# ===========================================================================
# Discord  --  always required
# ===========================================================================
# Bot token: https://discord.com/developers/applications -> Bot -> Reset Token
# Remember to enable MESSAGE CONTENT INTENT on that page.
DISCORD_TOKEN=your_bot_token_here

# Channel ID: Discord -> Settings -> Advanced -> Developer Mode on,
# then right-click the channel -> Copy Channel ID
DISCORD_CHANNEL_ID=000000000000000000

# ===========================================================================
# Your account
# ===========================================================================
# Used for position sizing. In GBP. Set this to what your OANDA demo
# account is actually worth, or the sizing is arithmetic about a fiction.
ACCOUNT_GBP=1000

# ===========================================================================
# AI reviewer  --  optional, off by default
# ===========================================================================
# A second opinion on trades the strategy has already found and sized.
#
# WHAT IT CAN DO: block a trade.
# WHAT IT CANNOT DO: open a trade, change a position size, move a stop or
# target, or reopen a risk gate. Sizing and every limit stay pure Python.
#
# Leave this off and the bot behaves exactly as it always has.
AI_ENABLED=off

# groq   = free, no card. https://console.groq.com -> API Keys
# gemini = free, no card. https://aistudio.google.com/apikey
AI_PROVIDER=groq

# Leave blank for the provider's default:
#   groq   -> openai/gpt-oss-120b
#   gemini -> gemini-3.5-flash
# NOTE: Groq retired llama-3.3-70b-versatile on 16 Aug 2026. If the bot
# reports "model not found", the model was deprecated — check
# https://console.groq.com/docs/deprecations and put the new name here.
AI_MODEL=

# Paste your own key. Never send it to anyone.
GROQ_API_KEY=
GEMINI_API_KEY=

# What to do when the API times out, errors, or returns nonsense.
#   abstain = let the trade through on the strategy alone (default). An
#             outage then changes nothing about how the bot behaves.
#   hold    = block the trade. Safer if you ever give the AI more power
#             than a veto; means a Groq outage stops all trading.
AI_FAIL_MODE=abstain

# ===========================================================================
# Behaviour
# ===========================================================================
# How often to scan for setups, in seconds.
SCAN_SECONDS=60

# Only used if both FX APIs are unreachable. The bot warns loudly when it
# falls back to this, so you know the GBP figures may be stale.
FX_FALLBACK_USD_GBP=0.79
